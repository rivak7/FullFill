# Square credentials stay on the backend. make dev-api reads the root .env.
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# Optional explicit frontend origins if the frontend and API use different hosts.
FULLFILL_WEB_ORIGINS=
# Required on Vercel: one shared access code of at least 32 characters.
# Use the same code on the ordering and kitchen sites.
# Never prefix this or the Square token with VITE_.
FULLFILL_ACCESS_KEY=

# Camera/vision configuration, connected independently of order ingress.
CAMERA_INDEX=0
PERCEPTRON_API_KEY=
PERCEPTRON_MODEL=
PORT=8000
PHOTON_ENABLED=false
MANAGER_PHONE=
