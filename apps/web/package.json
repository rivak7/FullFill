{
  "name": "fullfill-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:order": "vite --host 127.0.0.1 --mode order --port 5174 --strictPort",
    "dev:fulfill": "vite --host 127.0.0.1 --mode fulfill --port 5175 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:order": "tsc --noEmit && vite build --mode order",
    "build:fulfill": "tsc --noEmit && vite build --mode fulfill",
    "typecheck": "tsc --noEmit",
    "generate:contracts": "node scripts/generate-contracts.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.1.1",
    "json-schema-to-typescript": "^15.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.12"
  }
}
